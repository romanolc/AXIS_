NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000
# Deixe vazio para executar em DEMO_MODE sem PostgreSQL.
DATABASE_URL=
DATABASE_SSL=false
# Use um segredo aleatório longo fora do desenvolvimento.
JWT_SECRET=replace-with-a-long-random-secret
DEMO_MODE=true
SENSOR_SIMULATOR_ENABLED=false

# Integração futura/preparada com Google OAuth; não é funcional sem uma implementação de callback/provedor.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=

# Opcional: Supabase/Auth gerenciado ainda não é usado pelo login local atual.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Fator oficial configurável para CO2e. Não preencher com valor sem fonte/documentação.
EMISSION_FACTOR_VALUE=
EMISSION_FACTOR_UNIT=tCO2e/MWh
EMISSION_FACTOR_PERIOD=
EMISSION_FACTOR_SOURCE=MCTI/SIRENE - Fatores de emissao MDL/SIN
EMISSION_FACTOR_METHODOLOGY=Fator medio para inventarios corporativos do SIN
EMISSION_FACTOR_REFERENCE_DATE=
