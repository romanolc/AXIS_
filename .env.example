NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000
# Deixe vazio para executar em DEMO_MODE sem PostgreSQL.
DATABASE_URL=
DATABASE_SSL=false
# Use um segredo aleatório longo fora do desenvolvimento.
JWT_SECRET=replace-with-a-long-random-secret
DEMO_MODE=true
SENSOR_SIMULATOR_ENABLED=false

# Integração futura/preparada com Google OAuth; não é funcional sem uma implementação de callback/provedor.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=

# Opcional: Supabase/Auth gerenciado ainda não é usado pelo login local atual.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
